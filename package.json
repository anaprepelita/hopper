{
  "name": "hopper-mobile",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "github:check": "node scripts/github-check.mjs",
    "sync:motion": "node scripts/sync-motion.mjs",
    "build": "npm run mobile:build && npm run mobile:check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:cloud": "node scripts/sync-cloud.mjs",
    "premobile:build": "npm run sync:motion && npm run sync:cloud",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:icons": "node scripts/mobile-icons.mjs",
    "mobile:check": "node scripts/check-mobile.mjs",
    "mobile:sync:android": "npm run mobile:build && cap sync android",
    "mobile:sync:ios": "npm run mobile:build && cap sync ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:run:android": "npm run mobile:sync:android && cap run android",
    "mobile:run:ios": "npm run mobile:sync:ios && cap run ios",
    "mobile:live:android": "node scripts/live-reload.mjs android",
    "mobile:live:ios": "node scripts/live-reload.mjs ios",
    "mobile:live:restore": "node scripts/live-reload.mjs restore",
    "mobile:live:stop": "node scripts/live-reload.mjs stop",
    "typecheck": "tsc --noEmit",
    "android:apk:debug": "node scripts/build-android.mjs debug-apk",
    "android:apk": "node scripts/build-android.mjs apk",
    "android:aab": "node scripts/build-android.mjs aab",
    "android:release": "node scripts/build-android.mjs release"
  },
  "overrides": {
    "rolldown": "1.2.1",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@supabase/supabase-js": "2.117.2",
    "animejs": "4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "^9.32.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
